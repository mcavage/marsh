// Renovate sweeps every pinned dependency: Cargo crates, GitHub Actions, npm
// (the Kits' adapters), the DHI and Rust base images (by digest), and the agent
// CLIs the Kits install (Claude Code, Codex, Pi). Self-hosted: see
// .github/workflows/renovate.yml and .github/renovate-global.js.
//
// Updates merge when their normal CI checks pass. Builds consume version
// pins, package lockfiles and immutable image digests directly; there is no
// separate checksum/notice-record refresh or license-review status gate.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  labels: ["dependencies"],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency updates",
  automerge: true,
  platformAutomerge: false,
  prConcurrentLimit: 6,
  prHourlyLimit: 3,
  // Validate against current main so each update includes dependency pins
  // already merged by another PR.
  rebaseWhen: "behind-base-branch",
  // Avoid just-published releases (a compromised release is usually pulled
  // within days). Security updates ignore this, and so do the trusted vendors
  // (the last packageRules entries, one per ecosystem).
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  ignorePaths: ["vendor/**", "packaging/dhi-notices/**", "**/node_modules/**", "docs/**"],
  enabledManagers: ["github-actions", "cargo", "npm", "dockerfile", "pip_requirements", "custom.regex"],
  // scripts/requirements-publish.txt is not named requirements.txt.
  "pip_requirements": { managerFilePatterns: ["/(^|/)requirements-publish\\.txt$/"] },
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on the first day of the month"] },

  customManagers: [
    {
      description: "One Renovate version for the self-hosted bot, config validator and policy tests",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/renovate-version$/"],
      matchStrings: ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
    {
      description: "The shell VM template's DHI base (packaging/shell-image), by digest",
      customType: "regex",
      managerFilePatterns: ["/^packaging/shell-image$/"],
      matchStrings: ["(?<depName>\\S+?):(?<currentValue>[^\\s:@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
    {
      description: "RUST_IMAGE in the Makefile, by digest (mirrors packaging/linux-arm64/Dockerfile)",
      customType: "regex",
      managerFilePatterns: ["/^Makefile$/"],
      matchStrings: ["RUST_IMAGE \\?= (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
    {
      // DHI's own apt repository (public, Debian format): Docker Engine and the
      // shell template's Node.js, npm and Python ship no Debian copyright file,
      // so their versions are pinned explicitly.
      description: "DHI-built apt packages pinned by version (Kit VM floor, shell template)",
      customType: "regex",
      managerFilePatterns: ["/^packaging/image-base/[^/]+\\.packages$/", "/^packaging/shell/Dockerfile$/", "/^packaging/svc-engine/Dockerfile$/"],
      // The name must start the line or follow whitespace or a line
      // continuation, so flags such as `--fuzz=0` and `--chmod=0644` are not
      // taken for packages. (RE2: no lookbehind.)
      matchStrings: ["(?:^|[\\s\\\\])(?<depName>[a-z0-9][a-z0-9.+-]*)=(?<currentValue>[0-9][^\\s]*)"],
      datasourceTemplate: "deb",
      versioningTemplate: "deb",
      registryUrlTemplate: "http://dhi.io/deb/debian/main?suite=trixie&components=main&binaryArch=arm64",
    },
    // Each Kit declares its CLI once (args.version.default) and its ACP adapter
    // in `provides`. The adapter is also in package.json, so Renovate's npm
    // manager and these managers see the same package and update it together.
    {
      description: "Claude Code release installed by the claude Kit",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-claude/claude\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "@anthropic-ai/claude-code",
      datasourceTemplate: "npm",
    },
    {
      description: "Claude ACP adapter version declared in the claude Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-claude/claude\\.yaml$/"],
      matchStrings: ["claude-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "@agentclientprotocol/claude-agent-acp",
      datasourceTemplate: "npm",
    },
    {
      description: "Codex release installed by the codex Kit",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-codex/codex\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "openai/codex",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^rust-v(?<version>.+)$",
    },
    {
      description: "Codex ACP adapter version declared in the codex Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-codex/codex\\.yaml$/"],
      matchStrings: ["codex-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "@agentclientprotocol/codex-acp",
      datasourceTemplate: "npm",
    },
    {
      description: "Pi release installed by the pi Kit (must equal package.json's)",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-pi/pi\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "@earendil-works/pi-coding-agent",
      datasourceTemplate: "npm",
    },
    {
      description: "Pi ACP adapter version declared in the pi Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-pi/pi\\.yaml$/"],
      matchStrings: ["pi-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "pi-acp",
      datasourceTemplate: "npm",
    },
  ],

  packageRules: [
    {
      description: "Renovate engine updates follow the weekly Actions cadence and run the same policy tests",
      matchPackageNames: ["renovate"],
      groupName: "GitHub Actions",
      schedule: ["before 6am on monday"],
    },
    {
      description: "Publisher PyYAML wheels support Python through 3.14; raise with requirements-publish.txt",
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/python-versions"],
      matchFileNames: [".github/workflows/ci.yml"],
      allowedVersions: "<3.15",
    },
    {
      description: "CI follows the documented Node 24 toolchain and Renovate's Node engine requirement",
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/node-versions"],
      matchFileNames: [".github/workflows/ci.yml"],
      allowedVersions: "<25",
    },
    {
      // ignorePaths alone is not enough: presets set it too. Brush is a patched
      // vendored snapshot (docs/upstream/brush), and the notices archive holds
      // verbatim upstream files (Codex's Cargo.toml, workflows) as evidence.
      description: "Never bump vendored or archived upstream files",
      matchFileNames: ["vendor/**", "packaging/dhi-notices/**"],
      enabled: false,
    },
    {
      description: "Base images move by digest only; the Rust toolchain moves by hand with rust-toolchain.toml and CI",
      matchPackageNames: ["rust"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    {
      description: "DHI base images and apt pins move together so their package revisions stay compatible",
      matchPackageNames: ["dhi.io/**"],
      groupName: "DHI inputs",
      // Digest updates carry no release date.
      minimumReleaseAge: null,
      schedule: ["at any time"],
    },
    {
      description: "DHI-built apt packages travel with their base images",
      matchDatasources: ["deb"],
      groupName: "DHI inputs",
      // The Debian index carries no release date.
      minimumReleaseAge: null,
      schedule: ["at any time"],
    },
    {
      // The engine's pin is the one Compose version. The Kits fetch the same
      // version as Compose's release binary, pinned by SHA-256
      // (packaging/image-base/docker-compose.sh, kits/marsh-docker-cli), which
      // no manager here can update, and tests/release/test_compose_pins.py
      // fails until they match. Kept out of "DHI inputs" so a new Compose
      // release waiting for those copies does not hold back the DHI base and
      // the other apt pins; a new package revision of the same version passes
      // and merges on its own.
      description: "The services engine's Compose plugin: one PR, finished by hand when the version moves",
      matchDatasources: ["deb"],
      matchPackageNames: ["docker-compose-plugin"],
      groupName: "Docker Compose",
      prBodyNotes: [
        "If the upstream version moved, CI fails until every copy follows it: set `COMPOSE_VERSION` and both SHA-256 digests (from the release's `docker-compose-linux-{aarch64,x86_64}.sha256`) in `packaging/image-base/docker-compose.sh` and `kits/marsh-docker-cli/marsh-docker-cli.dockerfile`, append the release's two `VERSION ASSET SHA256` lines to `tests/release/compose-release-digests.txt`, then the version in `kits/marsh-docker-cli/marsh-docker-cli.yaml`, `kits/README.md` and `COMPOSE_FALLBACK_VERSION` in `crates/marsh-services/src/restore.rs` (`python3 tests/release/test_compose_pins.py`).",
      ],
    },
    {
      description: "Agent CLI releases",
      matchPackageNames: ["@anthropic-ai/claude-code", "openai/codex"],
      // Fast follow: agent CLIs release several times a day, and a merged bump
      // reaches stable users' Kits through :latest within the day (release.yml).
      // Both are trusted vendors, so they wait for no release age (below).
      schedule: ["at any time"],
    },
    {
      description: "A package that is both in a Kit descriptor and package.json updates in one PR",
      matchPackageNames: [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp",
        "@earendil-works/pi-coding-agent",
        "pi-acp",
      ],
      // The same fast follow as the agent CLIs above, but these are not
      // the vendors' own packages: the main risk is a release pulled soon
      // after publication, and 6 hours covers most of that window.
      minimumReleaseAge: "6 hours",
      schedule: ["at any time"],
    },
    {
      description: "Rust crates and other libraries: weekly, minor and patch together",
      matchManagers: ["cargo", "npm"],
      matchPackageNames: [
        "!@agentclientprotocol/claude-agent-acp",
        "!@agentclientprotocol/codex-acp",
        "!@earendil-works/pi-coding-agent",
        "!pi-acp",
      ],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "libraries (minor and patch)",
      schedule: ["before 6am on monday"],
    },
    {
      description: "GitHub Actions: weekly, one PR",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      schedule: ["before 6am on monday"],
    },
    // Owner decision: releases from the trusted vendors Docker, DHI, Anthropic
    // and OpenAI are taken as soon as they are published; everything else
    // keeps the minimum release age above (3 days, or 6 hours for the Kits'
    // ACP adapters and Pi). One rule per ecosystem, because a rule's
    // datasources and names match as a cross product: each vendor name is
    // exempt only where that vendor publishes it, so the same name elsewhere
    // (npm `docker-ce`, a Docker Hub image `openai/codex`) and every GitHub
    // Action, docker/* ones included, still wait. Last, so these override any
    // earlier age. tests/release/renovate-policy.mjs checks both sides.
    {
      description: "Trusted vendor Docker: its Engine, CLI, containerd, Compose and Buildx apt packages (DHI's repository, already exempt above)",
      matchDatasources: ["deb"],
      matchPackageNames: ["docker-ce", "docker-ce-cli", "containerd.io", "docker-compose-plugin", "docker-buildx-plugin"],
      minimumReleaseAge: null,
    },
    {
      description: "Trusted vendors Docker and DHI: docker/* images (such as docker/dockerfile) and dhi.io images",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker/**", "docker.io/docker/**", "dhi.io/**"],
      minimumReleaseAge: null,
    },
    {
      description: "Trusted vendors Anthropic and OpenAI: their npm scopes (Claude Code is @anthropic-ai/claude-code)",
      matchDatasources: ["npm"],
      matchPackageNames: ["@anthropic-ai/**", "@openai/**"],
      minimumReleaseAge: null,
    },
    {
      description: "Trusted vendor OpenAI: Codex's GitHub releases",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["openai/codex"],
      minimumReleaseAge: null,
    },
  ],
}
