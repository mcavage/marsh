// Renovate sweeps every pinned dependency: Cargo crates, GitHub Actions, npm
// (the Kits' adapters), the DHI and Rust base images (by digest), and the agent
// CLIs the Kits install (Claude Code, Codex, Pi). Self-hosted: see
// .github/workflows/renovate.yml and .github/renovate-global.js.
//
// Only agent CLI and ACP adapter releases merge themselves, once CI passes
// (see their packageRules); everything else is a reviewed change because the
// builds take pinned inputs on purpose (docs/design/supply-chain.md). Renovate
// only edits the pins: .github/workflows/renovate-refresh.yml then runs `make
// refresh-pins` on the branch, commits the regenerated records (checksums,
// notices, inventories) as refresh-pins@users.noreply.github.com, and posts the
// license delta. CI builds the images on the completed head; the "License
// review" status is red only when the delta needs the owner.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  labels: ["dependencies"],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency updates",
  prConcurrentLimit: 6,
  prHourlyLimit: 3,
  // Avoid just-published releases (a compromised release is usually pulled
  // within days). Security updates ignore this.
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  // The refresh-pins workflow's commit completes the branch; Renovate keeps
  // managing (and may rebase) it rather than treating it as edited by a person.
  gitIgnoredAuthors: ["refresh-pins@users.noreply.github.com"],
  ignorePaths: ["vendor/**", "packaging/dhi-notices/**", "**/node_modules/**", "docs/**"],
  enabledManagers: ["github-actions", "cargo", "npm", "dockerfile", "pip_requirements", "custom.regex"],
  // scripts/requirements-publish.txt is not named requirements.txt.
  "pip_requirements": { managerFilePatterns: ["/(^|/)requirements-publish\\.txt$/"] },
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on the first day of the month"] },

  customManagers: [
    {
      description: "The shell VM template's DHI base (packaging/shell-image), by digest",
      customType: "regex",
      managerFilePatterns: ["/^packaging/shell-image$/"],
      matchStrings: ["(?<depName>\\S+?):(?<currentValue>[^\\s:@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
    {
      description: "RUST_IMAGE in the Makefile, by digest (mirrors packaging/linux-arm64/Dockerfile)",
      customType: "regex",
      managerFilePatterns: ["/^Makefile$/"],
      matchStrings: ["RUST_IMAGE \\?= (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
    {
      // DHI's own apt repository (public, Debian format): Docker Engine and the
      // shell template's Node.js, npm and Python ship no Debian copyright file,
      // so they are pinned by version and refresh-pins indexes each version.
      description: "DHI-built apt packages pinned by version (Kit VM floor, shell template)",
      customType: "regex",
      managerFilePatterns: ["/^packaging/image-base/[^/]+\\.packages$/", "/^packaging/shell/Dockerfile$/"],
      matchStrings: ["(?<depName>[a-z0-9][a-z0-9.+-]*)=(?<currentValue>[0-9][^\\s]*)"],
      datasourceTemplate: "deb",
      versioningTemplate: "deb",
      registryUrlTemplate: "http://dhi.io/deb/debian/main?suite=trixie&components=main&binaryArch=arm64",
    },
    // Each Kit declares its CLI once (args.version.default) and its ACP adapter
    // in `provides`. The adapter is also in package.json, so Renovate's npm
    // manager and these managers see the same package and update it together.
    {
      description: "Claude Code release installed by the claude Kit",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-claude/claude\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "@anthropic-ai/claude-code",
      datasourceTemplate: "npm",
    },
    {
      description: "Claude ACP adapter version declared in the claude Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-claude/claude\\.yaml$/"],
      matchStrings: ["claude-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "@agentclientprotocol/claude-agent-acp",
      datasourceTemplate: "npm",
    },
    {
      description: "Codex release installed by the codex Kit",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-codex/codex\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "openai/codex",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^rust-v(?<version>.+)$",
    },
    {
      description: "Codex ACP adapter version declared in the codex Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-codex/codex\\.yaml$/"],
      matchStrings: ["codex-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "@agentclientprotocol/codex-acp",
      datasourceTemplate: "npm",
    },
    {
      description: "Pi release installed by the pi Kit (must equal package.json's)",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-pi/pi\\.yaml$/"],
      matchStrings: ["args:\\n  version:\\n    default: \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "@earendil-works/pi-coding-agent",
      datasourceTemplate: "npm",
    },
    {
      description: "Pi ACP adapter version declared in the pi Kit's provides",
      customType: "regex",
      managerFilePatterns: ["/^kits/marsh-pi/pi\\.yaml$/"],
      matchStrings: ["pi-acp@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "pi-acp",
      datasourceTemplate: "npm",
    },
  ],

  packageRules: [
    {
      // ignorePaths alone is not enough: presets set it too. Brush is a patched
      // vendored snapshot (docs/upstream/brush), and the notices archive holds
      // verbatim upstream files (Codex's Cargo.toml, workflows) as evidence.
      description: "Never bump vendored or archived upstream files",
      matchFileNames: ["vendor/**", "packaging/dhi-notices/**"],
      enabled: false,
    },
    {
      description: "Base images move by digest only; the Rust toolchain moves by hand with rust-toolchain.toml and CI",
      matchPackageNames: ["rust"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    {
      description: "All DHI bases in one PR: their license notices are verified together",
      matchPackageNames: ["dhi.io/**"],
      groupName: "DHI base images",
      // Digest updates carry no release date.
      minimumReleaseAge: null,
      schedule: ["at any time"],
    },
    {
      description: "DHI-built apt packages in one PR, with the DHI base images' cadence",
      matchDatasources: ["deb"],
      groupName: "DHI packages",
      // The Debian index carries no release date.
      minimumReleaseAge: null,
      schedule: ["at any time"],
    },
    {
      // refresh-pins regenerates release-checksums.txt and the release's notice
      // records on the branch.
      description: "Agent CLI releases",
      matchPackageNames: ["@anthropic-ai/claude-code", "openai/codex"],
      // Fast follow: agent CLIs release several times a day, and a merged bump
      // reaches stable users' Kits through :latest within the day (release.yml).
      // The main risk is a release pulled soon after publication; 6 hours
      // covers most of that window. GitHub merges the PR only when the
      // required checks pass (platformAutomerge).
      minimumReleaseAge: "6 hours",
      automerge: true,
      platformAutomerge: true,
      schedule: ["at any time"],
    },
    {
      description: "A package that is both in a Kit descriptor and package.json updates in one PR",
      matchPackageNames: [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp",
        "@earendil-works/pi-coding-agent",
        "pi-acp",
      ],
      // The same fast follow as the agent CLIs above.
      minimumReleaseAge: "6 hours",
      automerge: true,
      platformAutomerge: true,
      schedule: ["at any time"],
    },
    {
      description: "Pi's nested shrinkwrap pins brace-expansion; patch-pi-dependencies.mjs validates the reviewed version",
      matchFileNames: ["kits/marsh-pi/package.json"],
      matchPackageNames: ["brace-expansion"],
      enabled: false,
    },
    {
      description: "Rust crates and other libraries: weekly, minor and patch together",
      matchManagers: ["cargo", "npm"],
      matchPackageNames: [
        "!@agentclientprotocol/claude-agent-acp",
        "!@agentclientprotocol/codex-acp",
        "!@earendil-works/pi-coding-agent",
        "!pi-acp",
      ],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "libraries (minor and patch)",
      schedule: ["before 6am on monday"],
    },
    {
      description: "GitHub Actions: weekly, one PR",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      schedule: ["before 6am on monday"],
    },
  ],
}
