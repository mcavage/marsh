+# Visible gate for the marsh benchmark: the issue's own example, as a test.
+from tomlkit import item
+
+
+def test_deleting_an_empty_slice_keeps_the_rendering():
+    a = item([1, 2, 3])
+    del a[:0]
+    assert a == [1, 2, 3]
+    assert a.as_string() == "[1, 2, 3]"
