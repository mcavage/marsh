# Narrows the commands in allowed-commands. The wrapper applies every rule whose
# command pattern matches the command gog resolved (aliases and shortcuts
# included), so a rule holds however the agent spells the command.
#
#   reject    PATTERN FLAG...      refuse the command if any of these flags is given
#   force     PATTERN FLAG=VALUE   the flag is always VALUE: any other value is refused,
#                                  and a missing flag is added
#   nomention PATTERN              refuse any argument containing "@": comment text
#                                  with an @-mention or +email makes Google email
#                                  that person
#
# PATTERN is a shell glob over the dotted command path ("*" is every command).
# tests/kits/tools-policy.py checks that each rule names a real flag, that every
# rule is enforced in the built image, and that gog has no executable or
# destination flag, and no allowed comment command, these rules don't cover.

# Nothing runs code or opens a program: external renderers, hooks, browsers.
reject * --mmdc --on-change --on-new --open --browser

# New files land in My Drive root, where nothing is shared. Creating commands
# have no destination flag. A copy would otherwise inherit its source's folder
# (maybe a shared one), so copies are pinned to the root.
reject drive.mkdir --parent
reject drive.upload --parent
reject upload --parent
reject docs.create --parent
reject sheets.create --parent
force drive.copy --parent=root
force docs.copy --parent=root
force sheets.copy --parent=root
force slides.copy --parent=root
force slides.create --parent=root
force slides.create-from-template --parent=root

# Comments may not @-mention or +email anyone.
nomention docs.comments.*
nomention drive.comments.*
