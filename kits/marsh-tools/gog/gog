#!/bin/sh
# gog for agents. Reads Google, and creates, edits and comments on the files it
# created (the token's drive.file scope enforces "created by the agent"); never
# sends, notifies, shares, publishes, deletes or runs code. gog refuses every
# command not listed in allowed-commands, and flag-rules narrows the commands
# that are listed (see the policy in the Kit's README).
# The access token never enters this job: SBX's proxy swaps the placeholder.
set -eu

gogbin=/usr/local/libexec/gog
list=/usr/local/share/gog-allowed-commands
rules=/usr/local/share/gog-flag-rules
die() { echo "gog: $*" >&2; exit 2; }

for arg in "$@"; do
  case "$arg" in
    --enable-commands*|--disable-commands*|--access-token*|--gmail-no-send*|--home*|--client*|--readonly*)
      die "$arg is fixed by this tool and can't be changed" ;;
    --) die "-- is not supported by this tool" ;;
  esac
done

allowed=$(grep -v '^[[:space:]]*\(#\|$\)' "$list" | paste -sd, -) || allowed=
# An empty list would mean "everything", so refuse to run without one.
case "$allowed" in
  ''|*[!a-z0-9.,-]*) die "the allowed-command list is missing or invalid" ;;
esac
[ -s "$rules" ] || die "the flag rules are missing"
mkdir -p /tmp/gog-home

# Inherited GOG_* settings can't widen what is allowed. Everything else stays:
# SBX's proxy settings in the environment are how the credential gets attached.
for name in $(env | sed -n 's/^\(GOG_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$name"; done
export HOME=/tmp/gog-home

run() {
  exec "$gogbin" --home=/tmp/gog-home --access-token=proxy-managed --gmail-no-send "$@"
}

# Ask gog which command these arguments are, with nothing enabled: it parses
# them (aliases resolved) and refuses by name, running nothing. If it doesn't
# name a command (a usage error, --help), run the same way, so nothing runs.
named=$("$gogbin" --home=/tmp/gog-home --access-token=proxy-managed --gmail-no-send \
  --enable-commands-exact=none.none "$@" 2>&1 </dev/null || true)
cmd=$(printf '%s\n' "$named" | sed -n 's/^command "\([a-z0-9_ -]*\)" is not enabled (set --enable-commands.*$/\1/p' \
  | tail -n 1 | tr ' ' .)
[ -n "$cmd" ] || run --enable-commands-exact=none.none "$@"

rejects= forces= nomention=
while read -r kind pattern spec; do
  case "$kind" in ''|'#'*) continue ;; esac
  case "$cmd" in $pattern) ;; *) continue ;; esac
  case "$kind" in
    reject) rejects="$rejects $spec" ;;
    force) forces="$forces $spec" ;;
    nomention) nomention=1 ;;
    *) die "unknown flag rule: $kind" ;;
  esac
done < "$rules"

# A short flag (-f) is refused wherever its letter appears in a single-dash
# argument, which also covers -fVALUE and bundles like -nf.
for arg in "$@"; do
  for flag in $rejects; do
    case "$flag" in
      --*) case "$arg" in
             "$flag"|"$flag"=*) die "$flag is not available in $cmd" ;;
           esac ;;
      *) case "$arg" in
           --*) ;;
           -*"${flag#-}"*) die "$flag is not available in $cmd" ;;
         esac ;;
    esac
  done
done

# force: the flag has the given value; any other value is refused, and a
# missing flag is added.
for spec in $forces; do
  flag=${spec%%=*} value=${spec#*=} seen= pending=
  for arg in "$@"; do
    if [ -n "$pending" ]; then
      [ "$arg" = "$value" ] || die "$flag is fixed to $value in $cmd"
      pending=
      continue
    fi
    case "$arg" in
      "$flag") pending=1; seen=1 ;;
      "$flag"=*) [ "${arg#*=}" = "$value" ] || die "$flag is fixed to $value in $cmd"; seen=1 ;;
    esac
  done
  [ -z "$pending" ] || die "$flag needs a value"
  [ -n "$seen" ] || set -- "$@" "$flag=$value"
done

# nomention: comment text with an @ (an @-mention or +email) makes Google email
# that person, so any argument containing one is refused. (An --account value
# is an address, not text.)
if [ -n "$nomention" ]; then
  skip=
  for arg in "$@"; do
    if [ -n "$skip" ]; then skip=; continue; fi
    case "$arg" in
      --account|-a) skip=1 ;;
      --account=*) ;;
      *@*) die "@ isn't allowed in $cmd text: an @-mention or +email makes Google email that person" ;;
    esac
  done
fi

run --enable-commands-exact="$allowed" "$@"
