#!/bin/sh
# pi-dev: the Pi coding agent (1.0.0, npm-locked) in the shell VM (made for `marsh --dev`).
#
# Pi runs in the dev shell VM, so its tool calls run there too: `make
# dev-inner`, the session's `sbx` shim and the broker work as they do for the
# operator. Model access is stock SBX's: the VM's environment carries only
# proxy-managed sentinels and the SBX proxy injects the stored service secret.
# No host agent profile is read; Pi starts from its defaults. It is not named
# `pi` because the registered `pi` Kit command shadows that name in sessions.
set -eu
umask 077

if [ -n "${MARSH_DEV_SCRATCH:-}" ]; then
  # S/cache survives `--dev` sessions; S/home, S/control and S/tmp do not.
  state=$MARSH_DEV_SCRATCH/cache/pi-dev
else
  state=${HOME:?pi-dev: HOME is unset}/.pi-dev
fi
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$state/agent}"
export PI_TELEMETRY="${PI_TELEMETRY:-0}"
mkdir -p "$PI_CODING_AGENT_DIR"

# Seed defaults once; afterwards settings.json belongs to the operator.
settings=$PI_CODING_AGENT_DIR/settings.json
if [ ! -e "$settings" ]; then
  printf '{"defaultProvider":"anthropic","defaultModel":"claude-opus-5-5","enableInstallTelemetry":false}\n' >"$settings"
fi

case "${SBX_CRED_ANTHROPIC_MODE:-none}" in
  apikey|oauth) ;;
  *) echo "pi-dev: stock SBX supplies no Anthropic credential to this VM (sbx secret set -g anthropic)" >&2 ;;
esac

exec /opt/marsh/pi/node_modules/.bin/pi "$@"
