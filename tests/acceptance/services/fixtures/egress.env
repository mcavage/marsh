# Egress probe configuration (H-12, DECISIONS 17). KEY=VALUE lines, no quoting
# and no expansion; read by shell (`set -a; . egress.env`) and by python alike.
# `egress_preflight.py` checks all of it from the Mac at the start of a run.
#
# Bound by DECISIONS 17. Reachability: what a services container fetches when
# Internet is on.
EGRESS_URL=https://example.com/
# The host behind it, probed over IPv4 and IPv6 (the preflight resolves both;
# a Mac without IPv6 reachability reports ipv6=unavailable and the v6 probes
# are skipped, never silently passed).
EGRESS_HOST=example.com
# DNS is judged only by whether resolution of EGRESS_HOST succeeds or fails
# (`getent hosts example.com` in the container), never observed on a server.
# Echoes request headers as JSON ({"headers": {...}}): the credential canary.
# A synthetic injection rule for this host must never show up in what a
# services container sends.
EGRESS_ECHO_URL=https://httpbin.org/headers
# An approved-registry image whose digest is NOT in images.lock and shares no
# content with it (busybox 1.36 against the cached 1.37; not another tag of
# cached content): `docker pull` must really reach the registry.
EGRESS_ABSENT_IMAGE=busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
# A real, pinned image on a registry the services policy does not approve
# (quay.io): the pull must be refused.
EGRESS_DISALLOWED_IMAGE=quay.io/prometheus/busybox:latest@sha256:7379672d53c28113469275f2eb48adffa19954f39f8ef20c1e2992278f658e6c
# The pinned curl image the probe runs (it is in images.lock).
EGRESS_CURL_IMAGE=curlimages/curl:8.11.1@sha256:c1fe1679c34d9784c1b0d1e5f62ac0a79fca01fb6377cdd33e90473c6f9f9a69
