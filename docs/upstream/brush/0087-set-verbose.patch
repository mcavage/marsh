+/// `set -v`: like Bash, the shell writes each line of its input to standard
+/// error as it reads it, before running the commands that line completes.
+/// Lines read while `-v` is off are not written later.
+struct VerboseInput<'a> {
+    lines: std::iter::Peekable<std::str::SplitInclusive<'a, char>>,
+    /// How many lines of the text have been read.
+    read: usize,
+}
+
+impl<'a> VerboseInput<'a> {
+    /// Input over `text`, of which `read` lines have been read already.
+    fn new(text: &'a str, read: usize) -> Self {
+        let mut lines = text.split_inclusive('\n').peekable();
+        for _ in 0..read {
+            lines.next();
+        }
+        Self { lines, read }
+    }
+
+    /// Reads through line `line` (1-based), writing the lines if `-v` is on.
+    fn read_through(
+        &mut self,
+        shell: &crate::Shell<impl crate::extensions::ShellExtensions>,
+        params: &ExecutionParameters,
+        line: usize,
+    ) {
+        let verbose = shell.options().print_shell_input_lines;
+        while self.read < line {
+            let Some(text) = self.lines.next() else {
+                break;
+            };
+            self.read += 1;
+            if verbose {
+                let mut stderr = params.stderr(shell);
+                let _ = stderr.write_all(&crate::bytes::encode(text));
+                if !text.ends_with('\n') {
+                    let _ = stderr.write_all(b"\n");
+                }
+            }
+        }
+    }
+}
