+pub fn parse_pid(text: &str) -> Option<sys::process::ProcessId> {
+    let trimmed = text.trim_matches([' ', '\t', '\n']);
+    let digits = trimmed.strip_prefix(['+', '-']).unwrap_or(trimmed);
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    trimmed.parse().ok()
+}
