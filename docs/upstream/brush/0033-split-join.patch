diff --git a/brush-core/src/split.rs b/brush-core/src/split.rs
new file mode 100644
index 0000000..735725d
--- /dev/null
+++ b/brush-core/src/split.rs
@@ -0,0 +1,114 @@
+//! Embedding hook for marsh `split { ... } | join` private branch workspaces.
+//!
+//! Brush owns the composition: spooling input, running branches, capture
+//! budgets, cancellation, and the join stage. The embedding owns every write
+//! to the user's repository: snapshot, per-branch workspace allocation,
+//! result capture, the manifest and its rendering, and release.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, OnceLock};
+use std::time::Duration;
+
+/// How a branch ended.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SplitBranchState {
+    /// The branch exited on its own.
+    Exited,
+    /// The branch was interrupted by the split.
+    Cancelled,
+}
+
+/// One branch's captured result, in declaration order.
+#[derive(Clone, Debug)]
+pub struct SplitBranchOutcome {
+    /// Branch label.
+    pub label: String,
+    /// How the branch ended.
+    pub state: SplitBranchState,
+    /// Exit status.
+    pub status: u8,
+    /// Wall time from launch to reap.
+    pub elapsed: Duration,
+    /// Captured standard output (within the shared budget).
+    pub stdout: Vec<u8>,
+    /// Captured standard error (within the shared budget).
+    pub stderr: Vec<u8>,
+}
+
+/// Rendering options read from the `join` stage.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct SplitRenderOptions {
+    /// Emit the manifest instead of the text rendering.
+    pub json: bool,
+    /// Append the timing table to the text rendering.
+    pub timing: bool,
+}
+
+/// The completed result bundle handed to `join`.
+#[derive(Clone, Debug)]
+pub struct SplitBundle {
+    /// Bytes for the join stage's standard input (rendering or manifest).
+    pub input: Vec<u8>,
+    /// Exported environment for a join command.
+    pub environment: Vec<(String, String)>,
+}
+
+/// How the split ended, for release.
+#[derive(Clone, Debug)]
+pub enum SplitRelease {
+    /// Remove every workspace and the split directory.
+    Remove,
+    /// Keep everything and report why.
+    Retain(String),
+    /// Cancelled: remove reaped branches' workspaces; retain the listed unreaped ones.
+    Cancelled {
+        /// Labels whose exit was never confirmed.
+        unreaped: Vec<String>,
+    },
+}
+
+/// One prepared split: a snapshot plus one private workspace per branch.
+pub trait SplitPlan: Send {
+    /// Split identity.
+    fn id(&self) -> &str;
+    /// The working directory for `label` (the user's relative directory in its workspace).
+    fn branch_dir(&self, label: &str) -> PathBuf;
+    /// Exported environment for `label`'s branch.
+    fn branch_environment(&self, label: &str) -> Vec<(String, String)>;
+    /// Diagnostics to show before branches run (for example abandoned splits).
+    fn notices(&self) -> Vec<String>;
+    /// Capture every branch, detect drift, and write the manifest.
+    ///
+    /// # Errors
+    ///
+    /// Returns a one-line diagnostic when capture fails.
+    fn complete(
+        &mut self,
+        branches: &[SplitBranchOutcome],
+        total: Duration,
+        options: SplitRenderOptions,
+    ) -> Result<SplitBundle, String>;
+    /// Remove or retain workspaces, returning lines for standard error.
+    fn release(&mut self, outcome: SplitRelease) -> Vec<String>;
+}
+
+/// The embedding's workspace provider.
+pub trait SplitWorkspace: Send + Sync {
+    /// Preflight, snapshot, and allocate one workspace per label from `cwd`.
+    ///
+    /// # Errors
+    ///
+    /// Returns a one-line diagnostic; nothing is left behind on failure.
+    fn prepare(&self, cwd: &Path, labels: &[String]) -> Result<Box<dyn SplitPlan>, String>;
+}
+
+static SPLIT_WORKSPACE: OnceLock<Arc<dyn SplitWorkspace>> = OnceLock::new();
+
+/// Installs the process-wide split workspace provider. Only the first call takes effect.
+pub fn install_split_workspace_hook(hook: Arc<dyn SplitWorkspace>) {
+    let _ = SPLIT_WORKSPACE.set(hook);
+}
+
+pub(crate) fn workspace() -> Option<&'static Arc<dyn SplitWorkspace>> {
+    SPLIT_WORKSPACE.get()
+}
diff --git a/brush-core/src/split_interp.rs b/brush-core/src/split_interp.rs
new file mode 100644
index 0000000..11ea5aa
--- /dev/null
+++ b/brush-core/src/split_interp.rs
@@ -0,0 +1,760 @@
+//! marsh `split { ... } | join` execution.
+//!
+//! Each branch runs as a real forked shell in its own process group, with its
+//! working directory inside a private workspace prepared by the embedding
+//! (`crate::split`). The split, not the terminal, delivers interrupts to
+//! branches, so it can wait for every branch to be reaped before it releases
+//! any workspace.
+
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use brush_parser::ast::{self, CommandPrefixOrSuffixItem};
+
+use crate::interp::{
+    COMPOSITION_OUTPUT_LIMIT, CompositionFile, capture_bounded, composition_input,
+    execute_composition_segment, join_capture, setup_redirect,
+};
+use crate::openfiles::OpenFiles;
+use crate::split::{
+    SplitBranchOutcome, SplitBranchState, SplitPlan, SplitRelease, SplitRenderOptions,
+};
+use crate::{
+    ExecutionExitCode, ExecutionParameters, ExecutionResult, Shell, error, extensions, sys,
+};
+
+/// Where the split and its join sit in a pipeline.
+#[derive(Clone, Copy)]
+pub(crate) struct SplitShape {
+    split: usize,
+    join: Option<usize>,
+}
+
+/// Recognizes a pipeline with a `split` stage. The parser already rejected
+/// mixing it with another composition stage.
+pub(crate) fn split_shape(pipeline: &ast::Pipeline) -> Option<SplitShape> {
+    let split = pipeline
+        .seq
+        .iter()
+        .position(|command| matches!(command, ast::Command::Split(_)))?;
+    let join = pipeline
+        .seq
+        .get(split + 1)
+        .filter(|command| command.is_split_join_stage())
+        .map(|_| split + 1);
+    Some(SplitShape { split, join })
+}
+
+const JOIN_HELP: &str = "join - receive split results\n\nUsage: split { ... } | join [--json] [--timing] [--keep] [--] [COMMAND [ARG...]]\n\n  --json    the manifest instead of the text rendering\n  --timing  append per-branch and total wall time\n  --keep    keep the split directory even when join succeeds\n\nWith no COMMAND, join prints the rendering. COMMAND reads it on stdin with\nSPLIT_ID, SPLIT_DIR and SPLIT_MANIFEST exported, from the original directory.\nUse `command join` for coreutils join.\n";
+
+/// Grace period between SIGINT and SIGKILL for cancelled branches.
+const CANCEL_GRACE: Duration = Duration::from_secs(10);
+/// How long to wait for a killed branch group to disappear.
+const KILL_GRACE: Duration = Duration::from_secs(2);
+
+#[derive(Default)]
+struct JoinStage {
+    options: SplitRenderOptions,
+    keep: bool,
+    help: bool,
+    command: Option<(ast::Word, Vec<CommandPrefixOrSuffixItem>)>,
+    redirects: Vec<ast::IoRedirect>,
+}
+
+/// Reads `join` options up to the first non-option word or `--`; the rest is
+/// the join command, executed as an ordinary simple command.
+fn parse_join_stage(command: Option<&ast::Command>) -> Result<JoinStage, String> {
+    let mut stage = JoinStage::default();
+    let Some(ast::Command::Simple(simple)) = command else {
+        return Ok(stage);
+    };
+    let mut options_done = false;
+    let mut command_word = None;
+    let mut rest = Vec::new();
+    for item in simple.suffix.iter().flat_map(|suffix| suffix.0.iter()) {
+        if command_word.is_some() {
+            rest.push(item.clone());
+            continue;
+        }
+        match item {
+            CommandPrefixOrSuffixItem::IoRedirect(redirect) => {
+                stage.redirects.push(redirect.clone());
+            }
+            CommandPrefixOrSuffixItem::Word(word) if !options_done => match word.value.as_str() {
+                "--json" => stage.options.json = true,
+                "--timing" => stage.options.timing = true,
+                "--keep" => stage.keep = true,
+                "-h" | "--help" => stage.help = true,
+                "--" => options_done = true,
+                option if option.starts_with('-') => {
+                    return Err(format!(
+                        "join: unknown option: {option} (use `command join` for coreutils join)"
+                    ));
+                }
+                _ => command_word = Some(word.clone()),
+            },
+            CommandPrefixOrSuffixItem::Word(word)
+            | CommandPrefixOrSuffixItem::AssignmentWord(_, word) => {
+                command_word = Some(word.clone());
+            }
+            CommandPrefixOrSuffixItem::ProcessSubstitution(..) => {
+                return Err("join: a process substitution cannot name the join command".into());
+            }
+        }
+    }
+    if let Some(word) = command_word {
+        rest.extend(
+            stage
+                .redirects
+                .drain(..)
+                .map(CommandPrefixOrSuffixItem::IoRedirect),
+        );
+        stage.command = Some((word, rest));
+    }
+    Ok(stage)
+}
+
+fn single_quoted(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+/// The join command as an ordinary simple command with exported split context.
+fn join_simple_command(
+    word: &ast::Word,
+    rest: &[CommandPrefixOrSuffixItem],
+    environment: &[(String, String)],
+) -> ast::SimpleCommand {
+    let prefix = environment
+        .iter()
+        .map(|(name, value)| {
+            let value = ast::Word {
+                value: single_quoted(value),
+                loc: None,
+            };
+            CommandPrefixOrSuffixItem::AssignmentWord(
+                ast::Assignment {
+                    name: ast::AssignmentName::VariableName(name.clone()),
+                    value: ast::AssignmentValue::Scalar(value.clone()),
+                    append: false,
+                    loc: brush_parser::SourceSpan::default(),
+                },
+                ast::Word {
+                    value: format!("{name}={}", value.value),
+                    loc: None,
+                },
+            )
+        })
+        .collect::<Vec<_>>();
+    ast::SimpleCommand {
+        prefix: (!prefix.is_empty()).then_some(ast::CommandPrefix(prefix)),
+        word_or_name: Some(word.clone()),
+        suffix: (!rest.is_empty()).then(|| ast::CommandSuffix(rest.to_vec())),
+    }
+}
+
+fn settle<SE: extensions::ShellExtensions>(
+    shell: &mut Shell<SE>,
+    pipeline: &ast::Pipeline,
+    statuses: Vec<u8>,
+    status: u8,
+) -> ExecutionResult {
+    let mut result = ExecutionResult::new(status);
+    if pipeline.bang {
+        result.exit_code = ExecutionExitCode::from(u8::from(status == 0));
+    }
+    *shell.last_pipeline_statuses_mut() = statuses;
+    shell.set_last_exit_status(result.exit_code.into());
+    result
+}
+
+/// Status for every typed stage that did not run (split, then join if present).
+fn fail_stages(statuses: &mut Vec<u8>, shape: SplitShape, status: u8) {
+    statuses.push(status);
+    if shape.join.is_some() {
+        statuses.push(status);
+    }
+}
+
+fn write_lines<SE: extensions::ShellExtensions>(
+    shell: &Shell<SE>,
+    params: &ExecutionParameters,
+    lines: &[String],
+) -> Result<(), error::Error> {
+    let mut stderr = params.stderr(shell);
+    for line in lines {
+        writeln!(stderr, "split: {line}")?;
+    }
+    Ok(())
+}
+
+pub(crate) async fn execute_split_pipeline<SE: extensions::ShellExtensions>(
+    pipeline: &ast::Pipeline,
+    shape: SplitShape,
+    shell: &mut Shell<SE>,
+    params: &ExecutionParameters,
+) -> Result<ExecutionResult, error::Error> {
+    let mut statuses = Vec::new();
+    let join = match parse_join_stage(shape.join.map(|index| &pipeline.seq[index])) {
+        Ok(join) => join,
+        Err(message) => {
+            writeln!(params.stderr(shell), "{message}")?;
+            fail_stages(&mut statuses, shape, 2);
+            return Ok(settle(shell, pipeline, statuses, 2));
+        }
+    };
+    if join.help {
+        let suffix = &pipeline.seq[shape.join.unwrap_or(shape.split) + 1..];
+        if suffix.is_empty() {
+            params.stdout(shell).write_all(JOIN_HELP.as_bytes())?;
+            return Ok(settle(shell, pipeline, vec![0], 0));
+        }
+        let help = CompositionFile::create("join-help")?;
+        help.write()?.write_all(JOIN_HELP.as_bytes())?;
+        let mut suffix_params = params.clone();
+        suffix_params.set_fd(OpenFiles::STDIN_FD, help.read()?.into());
+        let result = execute_composition_segment(suffix, shell, &suffix_params).await?;
+        let mut statuses = vec![0];
+        statuses.extend_from_slice(shell.last_pipeline_statuses());
+        return Ok(settle(shell, pipeline, statuses, result.exit_code.into()));
+    }
+    let ast::Command::Split(split) = &pipeline.seq[shape.split] else {
+        unreachable!()
+    };
+
+    let Some((prefix_status, input)) =
+        composition_input(&pipeline.seq[..shape.split], shell, params, &mut statuses).await?
+    else {
+        fail_stages(&mut statuses, shape, 2);
+        return Ok(settle(shell, pipeline, statuses, 2));
+    };
+    if prefix_status != 0 {
+        fail_stages(&mut statuses, shape, prefix_status);
+        return Ok(settle(shell, pipeline, statuses, prefix_status));
+    }
+
+    let Some(workspace) = crate::split::workspace() else {
+        writeln!(
+            params.stderr(shell),
+            "split: private workspaces are unavailable here"
+        )?;
+        fail_stages(&mut statuses, shape, 2);
+        return Ok(settle(shell, pipeline, statuses, 2));
+    };
+    let labels = split
+        .branches
+        .iter()
+        .map(|branch| branch.label.clone())
+        .collect::<Vec<_>>();
+    let started = Instant::now();
+    let mut plan = match workspace.prepare(shell.working_dir(), &labels) {
+        Ok(plan) => plan,
+        Err(message) => {
+            writeln!(params.stderr(shell), "split: {message}")?;
+            fail_stages(&mut statuses, shape, 2);
+            return Ok(settle(shell, pipeline, statuses, 2));
+        }
+    };
+    write_lines(shell, params, &plan.notices())?;
+
+    #[cfg(unix)]
+    let ran = run_branches(split, shell, params, plan.as_mut(), Arc::new(input)).await?;
+    #[cfg(not(unix))]
+    let ran = {
+        drop(input);
+        BranchRun::Failed("split requires a Unix host".into())
+    };
+    let (outcomes, live_groups) = match ran {
+        BranchRun::Complete {
+            outcomes,
+            live_groups,
+        } => (outcomes, live_groups),
+        BranchRun::Failed(message) => {
+            writeln!(params.stderr(shell), "split: {message}")?;
+            let lines = plan.release(SplitRelease::Cancelled {
+                unreaped: Vec::new(),
+            });
+            write_lines(shell, params, &lines)?;
+            fail_stages(&mut statuses, shape, 2);
+            return Ok(settle(shell, pipeline, statuses, 2));
+        }
+        BranchRun::Cancelled {
+            status,
+            message,
+            unreaped,
+        } => {
+            if let Some(message) = message {
+                writeln!(params.stderr(shell), "split: {message}")?;
+            }
+            let lines = plan.release(SplitRelease::Cancelled { unreaped });
+            write_lines(shell, params, &lines)?;
+            fail_stages(&mut statuses, shape, status);
+            let result = settle(shell, pipeline, statuses, status);
+            #[cfg(unix)]
+            if status == 143 {
+                let signal = crate::traps::TrapSignal::Signal(sys::signal::Signal::SIGTERM);
+                let trap_result = shell.invoke_trap_handler(signal, params).await?;
+                if !trap_result.is_normal_flow() {
+                    return Ok(trap_result);
+                }
+            }
+            return Ok(result);
+        }
+    };
+
+    let branch_failure = outcomes
+        .iter()
+        .find(|outcome| outcome.status != 0)
+        .map_or(0, |outcome| outcome.status);
+    let bundle = match plan.complete(&outcomes, started.elapsed(), join.options) {
+        Ok(bundle) => bundle,
+        Err(message) => {
+            writeln!(params.stderr(shell), "split: {message}")?;
+            let lines = plan.release(SplitRelease::Retain("capture failed".into()));
+            write_lines(shell, params, &lines)?;
+            fail_stages(&mut statuses, shape, 2);
+            return Ok(settle(shell, pipeline, statuses, 2));
+        }
+    };
+    for outcome in &outcomes {
+        if !outcome.stderr.is_empty() {
+            let mut stderr = params.stderr(shell);
+            writeln!(stderr, "== {} stderr ==", outcome.label)?;
+            stderr.write_all(&outcome.stderr)?;
+            if !outcome.stderr.ends_with(b"\n") {
+                writeln!(stderr)?;
+            }
+        }
+    }
+    statuses.push(branch_failure);
+
+    let typed_end = shape.join.unwrap_or(shape.split) + 1;
+    let suffix = &pipeline.seq[typed_end..];
+    let input_file = CompositionFile::create("split-input")?;
+    input_file.write()?.write_all(&bundle.input)?;
+    let (join_status, mut status) = if let Some((word, rest)) = &join.command {
+        let mut segment = vec![ast::Command::Simple(join_simple_command(
+            word,
+            rest,
+            &bundle.environment,
+        ))];
+        segment.extend_from_slice(suffix);
+        let mut join_params = params.clone();
+        join_params.set_fd(OpenFiles::STDIN_FD, input_file.read()?.into());
+        let result = execute_composition_segment(&segment, shell, &join_params).await?;
+        let segment_statuses = shell.last_pipeline_statuses().to_vec();
+        let join_status = segment_statuses
+            .first()
+            .copied()
+            .unwrap_or_else(|| result.exit_code.into());
+        statuses.extend_from_slice(&segment_statuses);
+        (join_status, u8::from(result.exit_code))
+    } else {
+        let mut join_params = params.clone();
+        let rendered = (!suffix.is_empty())
+            .then(|| CompositionFile::create("join-output"))
+            .transpose()?;
+        if let Some(rendered) = &rendered {
+            join_params.set_fd(OpenFiles::STDOUT_FD, rendered.write()?.into());
+        }
+        for redirect in &join.redirects {
+            setup_redirect(shell, &mut join_params, redirect).await?;
+        }
+        join_params.stdout(shell).write_all(&bundle.input)?;
+        drop(join_params);
+        if shape.join.is_some() {
+            statuses.push(branch_failure);
+        }
+        if let Some(rendered) = &rendered {
+            let mut suffix_params = params.clone();
+            suffix_params.set_fd(OpenFiles::STDIN_FD, rendered.read()?.into());
+            let result = execute_composition_segment(suffix, shell, &suffix_params).await?;
+            statuses.extend_from_slice(shell.last_pipeline_statuses());
+            (branch_failure, u8::from(result.exit_code))
+        } else {
+            (branch_failure, branch_failure)
+        }
+    };
+    if shell.options().return_last_failure_from_pipeline
+        && let Some(failure) = statuses.iter().rev().find(|status| **status != 0)
+    {
+        status = *failure;
+    }
+
+    let release = if join_status != 0 {
+        SplitRelease::Retain(format!("join exited {join_status}"))
+    } else if join.keep {
+        SplitRelease::Retain("--keep".into())
+    } else if !live_groups.is_empty() {
+        SplitRelease::Retain(format!(
+            "branch processes still running: {}",
+            live_groups.join(", ")
+        ))
+    } else {
+        SplitRelease::Remove
+    };
+    let lines = plan.release(release);
+    write_lines(shell, params, &lines)?;
+    Ok(settle(shell, pipeline, statuses, status))
+}
+
+enum BranchRun {
+    Complete {
+        outcomes: Vec<SplitBranchOutcome>,
+        /// Labels whose process group still had members after the branch shell exited.
+        live_groups: Vec<String>,
+    },
+    Failed(String),
+    Cancelled {
+        status: u8,
+        message: Option<String>,
+        unreaped: Vec<String>,
+    },
+}
+
+#[cfg(unix)]
+struct Launched {
+    label: String,
+    pid: i32,
+    started: Instant,
+    stdout: std::thread::JoinHandle<std::io::Result<Vec<u8>>>,
+    stderr: std::thread::JoinHandle<std::io::Result<Vec<u8>>>,
+    input: std::thread::JoinHandle<std::io::Result<()>>,
+}
+
+#[cfg(unix)]
+struct Budget {
+    remaining: Arc<AtomicU64>,
+    exceeded: Arc<AtomicBool>,
+    reached: Arc<tokio::sync::Notify>,
+}
+
+/// A forked branch whose I/O threads have not started yet.
+#[cfg(unix)]
+struct Forked {
+    label: String,
+    pid: i32,
+    started: Instant,
+    input: std::io::PipeWriter,
+    stdout: std::io::PipeReader,
+    stderr: std::io::PipeReader,
+}
+
+/// Forks one branch shell. Spawns no thread: a thread starting while another
+/// branch forks can hold a runtime lock that the forked child then waits on
+/// forever, so every fork happens before any branch I/O thread starts.
+#[cfg(unix)]
+fn fork_branch<SE: extensions::ShellExtensions>(
+    branch: &ast::FanoutBranch,
+    shell: &Shell<SE>,
+    params: &ExecutionParameters,
+    dir: PathBuf,
+    environment: Vec<(String, String)>,
+) -> Result<Option<Forked>, error::Error> {
+    let (input_reader, input_writer) = std::io::pipe()?;
+    let (stdout_reader, stdout_writer) = std::io::pipe()?;
+    let (stderr_reader, stderr_writer) = std::io::pipe()?;
+
+    let mut child_shell = shell.clone();
+    child_shell.options_mut().interactive = false;
+    child_shell.options_mut().enable_job_control = false;
+    child_shell.jobs_mut().clear_inherited();
+    child_shell.set_working_dir(&dir)?;
+    for (name, value) in environment {
+        let mut variable = crate::ShellVariable::new(value);
+        variable.export();
+        child_shell.set_env_global(&name, variable)?;
+    }
+    let mut child_params = params.clone();
+    child_params.set_fd(OpenFiles::STDIN_FD, input_reader.into());
+    child_params.set_fd(OpenFiles::STDOUT_FD, stdout_writer.into());
+    child_params.set_fd(OpenFiles::STDERR_FD, stderr_writer.into());
+    child_params.process_group_policy = crate::ProcessGroupPolicy::SameProcessGroup;
+    let body = branch.body.clone();
+    let child = crate::interp::fork_child(
+        child_shell,
+        child_params,
+        crate::subshell::ChildGroup::New { foreground: false },
+        false,
+        Box::new(move |shell, params| {
+            Box::pin(async move {
+                crate::interp::run_list_reporting_errors(&body, shell, &params).await
+            })
+        }),
+    )?;
+    let Some(pid) = child.as_ref().and_then(crate::processes::ChildProcess::pid) else {
+        return Ok(None);
+    };
+    Ok(Some(Forked {
+        label: branch.label.clone(),
+        pid,
+        started: Instant::now(),
+        input: input_writer,
+        stdout: stdout_reader,
+        stderr: stderr_reader,
+    }))
+}
+
+/// Starts a forked branch's input pump and output capture threads.
+#[cfg(unix)]
+fn start_branch_io(forked: Forked, input: Arc<Vec<u8>>, budget: &Budget) -> Launched {
+    let mut writer = forked.input;
+    let input = std::thread::spawn(move || match writer.write_all(&input) {
+        Ok(()) => Ok(()),
+        Err(error) if error.kind() == std::io::ErrorKind::BrokenPipe => Ok(()),
+        Err(error) => Err(error),
+    });
+    let capture = |reader: std::io::PipeReader| {
+        let remaining = Arc::clone(&budget.remaining);
+        let exceeded = Arc::clone(&budget.exceeded);
+        let reached = Arc::clone(&budget.reached);
+        std::thread::spawn(move || capture_bounded(reader, &remaining, &exceeded, &reached))
+    };
+    Launched {
+        label: forked.label,
+        pid: forked.pid,
+        started: forked.started,
+        stdout: capture(forked.stdout),
+        stderr: capture(forked.stderr),
+        input,
+    }
+}
+
+/// Whether any process remains in the group led by `pgid`.
+#[cfg(unix)]
+fn group_alive(pgid: i32) -> bool {
+    // SAFETY: signal 0 only probes for existence and permission.
+    unsafe { libc::killpg(pgid, 0) == 0 }
+}
+
+#[cfg(unix)]
+fn signal_group(pgid: i32, signal: i32) {
+    // SAFETY: signals only the branch's own process group.
+    unsafe {
+        libc::killpg(pgid, signal);
+    }
+}
+
+#[cfg(unix)]
+fn exit_status_byte(status: std::process::ExitStatus) -> u8 {
+    use std::os::unix::process::ExitStatusExt as _;
+    let code = status
+        .code()
+        .unwrap_or_else(|| 128 + status.signal().unwrap_or(0));
+    u8::try_from(code & 0xff).unwrap_or(u8::MAX)
+}
+
+/// Reaps a branch shell without blocking. `true` once it has exited.
+#[cfg(unix)]
+fn try_reap(pid: i32) -> Option<u8> {
+    use std::os::unix::process::ExitStatusExt as _;
+    let mut status = 0;
+    // SAFETY: waits only for this specific child, without blocking.
+    let result = unsafe { libc::waitpid(pid, &raw mut status, libc::WNOHANG) };
+    if result == pid {
+        Some(exit_status_byte(std::process::ExitStatus::from_raw(status)))
+    } else if result == -1 {
+        // Already reaped elsewhere (ECHILD): nothing left to wait for.
+        Some(255)
+    } else {
+        None
+    }
+}
+
+/// Interrupts every branch that has not been reaped, waits for each branch
+/// shell and its whole process group to exit, then kills what remains.
+/// Returns the labels whose exit could not be confirmed.
+#[cfg(unix)]
+async fn cancel_branches(
+    launched: &[Launched],
+    reaped: &Mutex<Vec<Option<(u8, Duration)>>>,
+) -> Vec<String> {
+    let mut done = reaped
+        .lock()
+        .map(|reaped| reaped.iter().map(Option::is_some).collect::<Vec<_>>())
+        .unwrap_or_else(|_| vec![false; launched.len()]);
+    let settled = |done: &mut Vec<bool>| {
+        for (index, branch) in launched.iter().enumerate() {
+            if !done[index] && try_reap(branch.pid).is_some() {
+                done[index] = true;
+            }
+        }
+        launched
+            .iter()
+            .enumerate()
+            .all(|(index, branch)| done[index] && !group_alive(branch.pid))
+    };
+    for branch in launched {
+        if group_alive(branch.pid) {
+            signal_group(branch.pid, libc::SIGINT);
+        }
+    }
+    for (grace, kill) in [(CANCEL_GRACE, true), (KILL_GRACE, false)] {
+        let deadline = Instant::now() + grace;
+        while Instant::now() < deadline {
+            if settled(&mut done) {
+                return Vec::new();
+            }
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+        if settled(&mut done) {
+            return Vec::new();
+        }
+        if kill {
+            for branch in launched {
+                if group_alive(branch.pid) {
+                    signal_group(branch.pid, libc::SIGKILL);
+                }
+            }
+        }
+    }
+    launched
+        .iter()
+        .enumerate()
+        .filter(|(index, branch)| !done[*index] || group_alive(branch.pid))
+        .map(|(_, branch)| branch.label.clone())
+        .collect()
+}
+
+#[cfg(unix)]
+async fn run_branches<SE: extensions::ShellExtensions>(
+    split: &ast::FanoutCommand,
+    shell: &Shell<SE>,
+    params: &ExecutionParameters,
+    plan: &mut dyn SplitPlan,
+    input: Arc<Vec<u8>>,
+) -> Result<BranchRun, error::Error> {
+    let budget = Budget {
+        remaining: Arc::new(AtomicU64::new(COMPOSITION_OUTPUT_LIMIT)),
+        exceeded: Arc::new(AtomicBool::new(false)),
+        reached: Arc::new(tokio::sync::Notify::new()),
+    };
+    let reaped = Arc::new(Mutex::new(vec![None; split.branches.len()]));
+    let mut forked = Vec::with_capacity(split.branches.len());
+    let mut failure = None;
+    for branch in &split.branches {
+        match fork_branch(
+            branch,
+            shell,
+            params,
+            plan.branch_dir(&branch.label),
+            plan.branch_environment(&branch.label),
+        ) {
+            Ok(Some(child)) => forked.push(child),
+            Ok(None) => {
+                failure = Some("private branches need real-process subshells".to_owned());
+                break;
+            }
+            Err(error) => {
+                failure = Some(format!("cannot start branch {}: {error}", branch.label));
+                break;
+            }
+        }
+    }
+    let launched = forked
+        .into_iter()
+        .map(|child| start_branch_io(child, Arc::clone(&input), &budget))
+        .collect::<Vec<_>>();
+    if let Some(message) = failure {
+        let unreaped = cancel_branches(&launched, &reaped).await;
+        return Ok(if unreaped.is_empty() {
+            BranchRun::Failed(message)
+        } else {
+            BranchRun::Cancelled {
+                status: 2,
+                message: Some(message),
+                unreaped,
+            }
+        });
+    }
+
+    let waits = launched.iter().enumerate().map(|(index, branch)| {
+        let reaped = Arc::clone(&reaped);
+        let pid = branch.pid;
+        let started = branch.started;
+        async move {
+            let status = match crate::subshell::wait_for_pid(pid).await {
+                Ok(output) => exit_status_byte(output.status),
+                Err(_) => 255,
+            };
+            if let Ok(mut reaped) = reaped.lock() {
+                reaped[index] = Some((status, started.elapsed()));
+            }
+        }
+    });
+    enum Completion {
+        Complete,
+        OutputLimit,
+        Interrupted,
+        Terminated,
+    }
+    let term_trapped = shell.traps().handles(crate::traps::TrapSignal::Signal(
+        sys::signal::Signal::SIGTERM,
+    ));
+    let completion = {
+        let all = futures::future::join_all(waits);
+        tokio::pin!(all);
+        tokio::select! {
+            _ = &mut all => Completion::Complete,
+            () = budget.reached.notified() => Completion::OutputLimit,
+            result = sys::signal::await_ctrl_c() => {
+                result?;
+                Completion::Interrupted
+            },
+            result = sys::signal::await_term(), if term_trapped => {
+                result?;
+                Completion::Terminated
+            },
+        }
+    };
+    let (status, message) = match completion {
+        Completion::Complete if !budget.exceeded.load(Ordering::Relaxed) => {
+            let statuses = reaped
+                .lock()
+                .map(|reaped| reaped.clone())
+                .unwrap_or_default();
+            let live_groups = launched
+                .iter()
+                .filter(|branch| group_alive(branch.pid))
+                .map(|branch| branch.label.clone())
+                .collect();
+            let mut outcomes = Vec::with_capacity(launched.len());
+            for (branch, reaped) in launched.into_iter().zip(statuses) {
+                let (status, elapsed) = reaped.unwrap_or((255, Duration::ZERO));
+                branch
+                    .input
+                    .join()
+                    .map_err(|_| std::io::Error::other("split input thread panicked"))??;
+                outcomes.push(SplitBranchOutcome {
+                    label: branch.label,
+                    state: SplitBranchState::Exited,
+                    status,
+                    elapsed,
+                    stdout: join_capture(branch.stdout)?,
+                    stderr: join_capture(branch.stderr)?,
+                });
+            }
+            return Ok(BranchRun::Complete {
+                outcomes,
+                live_groups,
+            });
+        }
+        Completion::Complete | Completion::OutputLimit => (
+            130,
+            Some("split combined output exceeds 16 MiB limit; branches cancelled".to_owned()),
+        ),
+        Completion::Interrupted => (130, None),
+        Completion::Terminated => (143, None),
+    };
+    let unreaped = cancel_branches(&launched, &reaped).await;
+    // Capture threads end when the branch groups close their pipes; they hold
+    // nothing the split still needs.
+    drop(launched);
+    Ok(BranchRun::Cancelled {
+        status,
+        message,
+        unreaped,
+    })
+}
