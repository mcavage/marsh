+/// Rejects pipeline shapes that mix `split` with another composition stage.
+/// Pipelines without `split` keep their existing (runtime-checked) behavior.
+fn validate_split_sequence(stages: &[(ast::Command, bool)]) -> Result<(), &'static str> {
+    let Some(split) = stages
+        .iter()
+        .position(|(command, _)| matches!(command, ast::Command::Split(_)))
+    else {
+        return Ok(());
+    };
+    let compositions = stages
+        .iter()
+        .filter(|(command, _)| matches!(command, ast::Command::Fanout(_) | ast::Command::Split(_)))
+        .count();
+    if compositions > 1 {
+        return Err("a pipeline has at most one fanout or split stage");
+    }
+    match stages.get(split + 1) {
+        Some((ast::Command::Collect(_), _)) => Err("collect follows fanout; use join after split"),
+        Some((command, true)) if command.is_split_join_stage() => {
+            Err("|& is unsupported for marsh composition stages")
+        }
+        _ => Ok(()),
+    }
+}
