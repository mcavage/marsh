+        // complete prefix for every token made ordinary large scripts O(n²).
+        let fanout = command_start
+            && matches!((&tokens[start], &tokens[start + 1]),
+            (Token::Word(name, _), Token::Word(open, _)) if name == "fanout" && open == "{");
