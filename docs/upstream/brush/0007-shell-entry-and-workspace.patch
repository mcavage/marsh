+        "--config",
+        "--inherit-fd",
+        "--closed-fd",
+        "--rcfile",
+        "--init-file",
+        "--xtrace-file",
+        "--input-backend",
+        "--load",
+        "--debug",
+        "--log-enable",
+        "--disable-event",
+        "--log-disable",
+    ];
