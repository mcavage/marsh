+    }
+    for (name, on) in finals(shopt) {
+        kept.push(if on { "-O" } else { "--+O" }.to_owned());
+        kept.push(name);
+    }
+    kept.extend(args.drain(index.min(args.len())..));
+    *args = kept;
+    Ok(())
