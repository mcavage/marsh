+            continue;
+        }
+        if arg.starts_with("--") {
+            let takes_value = LONG_VALUE_OPTIONS.contains(&arg.as_str());
+            kept.push(arg);
+            if takes_value && let Some(value) = args.get(index) {
+                kept.push(value.clone());
+                index += 1;
+            }
