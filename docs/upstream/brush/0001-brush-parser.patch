+                    if self.at_command_start && word == "{" {
+                        self.groups += 1;
+                    }
+                    self.at_command_start = matches!(
+                        word,
+                        "{" | "then"
+                            | "do"
+                            | "else"
+                            | "elif"
+                            | "if"
+                            | "while"
+                            | "until"
+                            | "!"
+                            | "time"
+                    ) && self.at_command_start;
+                    self.after_word = matches!(result.reason, TokenEndReason::Other);
+                }
+            }
