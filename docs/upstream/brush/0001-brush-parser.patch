+            Some(Token::Operator(operator, _)) => {
+                self.at_command_start = !matches!(operator.as_str(), ")" | ">" | "<" | ">>");
+            }
+            Some(Token::Word(word, _)) => {
+                let word = word.trim_matches([' ', '\t']);
