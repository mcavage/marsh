+    groups: usize,
+    /// Whether the next word would start a command.
+    at_command_start: bool,
+    /// Whether the last token was a word that the next char directly follows.
+    after_word: bool,
+}
+
+impl Default for CommandPosition {
+    fn default() -> Self {
+        Self {
+            groups: 0,
+            at_command_start: true,
+            after_word: false,
+        }
+    }
