 #[derive(Clone, Debug, Default)]
 pub(crate) struct FilenameExpansionOptions {
     pub require_dot_in_pattern_to_match_dot_files: bool,
+    /// `globstar`: a `**` path component matches any number of directories.
+    pub globstar: bool,
+}
+
+/// Appends `dir`'s descendants (directories only, or every entry) in sorted
+/// pre-order, skipping dot entries unless allowed. Like Bash, `**` does not
+/// descend through symbolic links to directories.
+fn push_descendants(
+    dir: &Path,
+    directories_only: bool,
+    allow_dot_files: bool,
+    out: &mut Vec<std::path::PathBuf>,
+) {
+    let Ok(entries) = dir.read_dir() else {
+        return;
+    };
+    let mut entries: Vec<_> = entries
+        .filter_map(Result::ok)
+        .filter(|entry| allow_dot_files || !entry.file_name().to_string_lossy().starts_with('.'))
+        .collect();
+    entries.sort_by_key(std::fs::DirEntry::file_name);
+    for entry in entries {
+        let is_dir = entry.file_type().is_ok_and(|kind| kind.is_dir());
+        if is_dir || !directories_only {
+            out.push(entry.path());
+        }
+        if is_dir {
+            push_descendants(&entry.path(), directories_only, allow_dot_files, out);
+        }
+    }
 }
 
