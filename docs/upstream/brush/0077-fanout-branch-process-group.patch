+fn spawn_awaitable<T: Send + 'static>(
+    work: impl FnOnce() -> T + Send + 'static,
+) -> tokio::sync::oneshot::Receiver<T> {
+    let (sender, receiver) = tokio::sync::oneshot::channel();
+    drop(spawn_running(move || {
+        let _ = sender.send(work());
+    }));
+    receiver
