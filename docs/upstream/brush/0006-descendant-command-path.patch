+fn prepend_external_path(directory: &str, current: Option<&str>) -> String {
+    let mut entries = vec![directory];
+    if let Some(current) = current {
+        entries.extend(current.split(':').filter(|entry| *entry != directory));
+    }
+    entries.join(":")
+}
