+    args:
+      - "-c"
+      - |
+        sh -c 'sleep 0.05; exit 23' &
+        pid=$!
+        test -n "$pid" || exit 90
+        wait "$pid"
+        test "$?" -eq 23
+
+  - name: "jobs -p reports the last background PID"
+    args:
+      - "-c"
+      - |
+        sleep 0.1 &
+        pid=$!
+        test "$(jobs -p)" = "$pid"
+        wait "$pid"
+
+  - name: "jobs -l includes PID and command"
+    args:
+      - "-c"
+      - |
+        sleep 0.1 &
+        pid=$!
+        jobs -l >jobs.txt
+        grep -F "$pid" jobs.txt >/dev/null
+        grep -F 'sleep 0.1' jobs.txt >/dev/null
+        rm jobs.txt
+        wait "$pid"
