+/// Returns an array element's subscript: an associative array's key is the
+/// subscript text (already expanded), an indexed array's is its arithmetic value.
+fn element_subscript(
+    shell: &mut Shell<impl extensions::ShellExtensions>,
+    name: &str,
+    index_expr: &ast::ArithmeticExpr,
+    depth: u32,
+) -> Result<String, EvalError> {
+    if shell
+        .env()
+        .get(name)
+        .is_some_and(|(_, var)| var.value().is_associative_array())
+    {
+        return Ok(index_expr.to_string());
+    }
+    Ok(eval_expr_impl(index_expr, shell, depth)?.to_string())
+}
