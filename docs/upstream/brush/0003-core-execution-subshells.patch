+/// terminal, as the same composition would treat it locally.
+fn relayed_terminal(file: &openfiles::OpenFile) -> bool {
+    use std::os::unix::fs::MetadataExt as _;
+    let Some(expected) = std::env::var_os("MARSH_TERMINAL_STDIN") else {
