+#[cfg(unix)]
+pub(crate) type ForkedBody<SE> = Box<
+    dyn for<'a> FnOnce(
+            &'a mut Shell<SE>,
+            ExecutionParameters,
+        )
+            -> std::pin::Pin<Box<dyn std::future::Future<Output = ExecutionResult> + 'a>>
+        + Send,
