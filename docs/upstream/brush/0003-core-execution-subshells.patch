+        capture_bounded(
+            stderr_reader,
+            &remaining_output,
+            &output_exceeded,
+            &output_limit_reached,
+        )
+    });
+    params.set_fd(OpenFiles::STDIN_FD, input_reader.into());
+    params.set_fd(OpenFiles::STDOUT_FD, stdout_writer.into());
+    params.set_fd(OpenFiles::STDERR_FD, stderr_writer.into());
+    shell.options_mut().interactive = false;
+    shell.options_mut().kill_external_commands_on_drop = true;
+    let started = std::time::Instant::now();
+    let result = branch.body.execute(&mut shell, &params).await?;
+    drop(params);
+    drop(shell);
+    let thread_ended = |_| std::io::Error::other("composition capture thread panicked");
+    input_pump.await.map_err(thread_ended)??;
+    let stdout = stdout_capture.await.map_err(thread_ended)??;
+    let stderr = stderr_capture.await.map_err(thread_ended)??;
+    #[cfg(unix)]
+    group.stop_group_on_drop(false);
+    Ok(BranchResult {
+        label: branch.label.clone(),
+        status: result.exit_code.into(),
+        elapsed: started.elapsed(),
+        stdout,
+        stderr,
+    })
+}
