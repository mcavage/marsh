+/// Replaces this forked child with the external command, as Bash does for the
+/// last command of a subshell. Returns only if the command cannot run.
+#[cfg(unix)]
+fn exec_external_command_in_place(
+    context: ExecutionContext<'_, impl extensions::ShellExtensions>,
+    executable_path: &Path,
+    argv0_override: Option<&str>,
+    args: &[CommandArg],
+) -> Result<ExecutionSpawnResult, error::Error> {
+    use std::io::Write as _;
+    let cmd_args = args
+        .iter()
+        .filter_map(|e| {
+            if let CommandArg::String(s) = e {
+                Some(s)
+            } else {
+                None
+            }
+        })
+        .collect::<Vec<_>>();
+    let argv0 = argv0_override.unwrap_or(context.command_name.as_str());
+    let request = compose_launch_request(
+        &context,
+        executable_path,
+        argv0,
+        cmd_args.as_slice(),
+        ProgramEnvironment::Command,
+    );
+    let _ = std::io::stdout().flush();
+    let _ = std::io::stderr().flush();
+    let spawn_err = sys::process::exec(request);
+    Err(spawn_error(context, executable_path, spawn_err))
+}
+
+#[cfg(not(unix))]
+fn exec_external_command_in_place(
+    context: ExecutionContext<'_, impl extensions::ShellExtensions>,
+    executable_path: &Path,
+    argv0_override: Option<&str>,
+    args: &[CommandArg],
+) -> Result<ExecutionSpawnResult, error::Error> {
+    execute_external_command(context, executable_path, None, argv0_override, args)
+}
