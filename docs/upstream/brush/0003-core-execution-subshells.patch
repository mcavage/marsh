+    let Some(name) = name else {
+        return false;
+    };
+    if name.contains('/') {
+        return true;
+    }
+    if shell.funcs().get(name).is_some() {
+        return false;
+    }
+    shell
+        .builtins()
+        .get(name)
+        .filter(|builtin| builtin.is_enabled())
+        .is_none_or(|builtin| builtin.process_shim().is_some())
+}
